# Copy this file to .env and add your own provider settings.
# openai-compatible, anthropic, or ollama
OPENPROSPECT_AI_PROVIDER=openai-compatible
OPENPROSPECT_AI_MODEL=
OPENPROSPECT_AI_API_KEY=
OPENPROSPECT_AI_BASE_URL=https://api.openai.com/v1
OPENPROSPECT_HOST=127.0.0.1
OPENPROSPECT_PORT=5555
# Optional: set a custom data directory
# OPENPROSPECT_HOME=C:/Users/YourName/.openprospect
